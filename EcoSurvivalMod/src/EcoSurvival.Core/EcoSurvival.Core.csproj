<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-independent rules. No Eco types are referenced here, so this project
    builds and is tested without the Eco server installed.
    netstandard2.1 keeps it loadable by the .NET runtime Eco uses.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>EcoSurvival.Core</RootNamespace>
    <AssemblyName>EcoSurvival.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
