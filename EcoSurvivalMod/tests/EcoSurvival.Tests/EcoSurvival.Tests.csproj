<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner: runs with `dotnet run`, exit code 1 on any failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>EcoSurvival.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcoSurvival.Core\EcoSurvival.Core.csproj" />
  </ItemGroup>

</Project>
